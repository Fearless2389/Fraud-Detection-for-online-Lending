# --- secrets: nothing in this family is ever committed ---
.env
.env.local
.env.*.local
*.pem
kaggle.json
**/serviceAccount*.json

# --- data: BAF is CC BY-NC-ND, and large. Ship the loader, never the CSVs. ---
backend/ml/data/raw/
backend/ml/data/interim/
backend/ml/data/processed/
*.csv
*.parquet

# --- model artifacts: reproducible from training scripts ---
backend/ml/artifacts/*.pkl
backend/ml/artifacts/*.joblib
backend/ml/artifacts/*.txt
backend/ml/artifacts/*.json
!backend/ml/artifacts/.gitkeep

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/

# --- node / frontend ---
node_modules/
dist/
dist-ssr/
.vite/
*.local

# --- report build intermediates ---
# The build scripts render these, then Chromium turns them into PDFs. The PDFs
# are committed; the HTML is a by-product with megabytes of inlined base64
# images and no reason to be in a diff.
docs/report.html

# --- rehearsal material: kept on disk, never published ---
# prep/ holds the console walkthrough and demo run-sheet. They are working
# notes for whoever is presenting - what to point at, what to say, how to
# answer a challenge - and they are nobody else's business. The report in
# docs/ is the document intended for readers.
prep/

# --- os / editor ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
