# =============================================================================
# Aegis - example environment file
#
# Copy to `.env` and fill in real values. `.env` is gitignored and must NEVER
# be committed. Every secret in this project is read from the environment;
# there are no credentials anywhere in the source tree.
#
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
# =============================================================================

# --- application ---
APP_ENV=local                       # local | staging | production
LOG_LEVEL=INFO

# --- API security ---
# Any client calling the scoring API must present this in the X-API-Key header.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=replace-me-with-a-generated-key

# Comma-separated origins allowed to call the API. Deploy-ready: the frontend
# origin is configuration, never hardcoded, so hosting this later is a config
# change rather than a code change.
CORS_ORIGINS=http://localhost:5173

# --- database (Supabase Postgres + pgvector) ---
# Supabase dashboard -> Project Settings -> Database -> Connection string (URI).
# Use the *session pooler* / direct connection string, and keep sslmode=require.
DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# --- AI layer (Gemini) ---
# https://aistudio.google.com/apikey
# Used ONLY to narrate explanations that deterministic models already produced.
# The LLM never influences an approve/block decision.
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-3.6-flash
GEMINI_ENABLED=true                 # false -> deterministic template reason codes

# --- data + artifact locations (kept outside OneDrive on purpose) ---
# OneDrive syncing a venv or a ~1GB dataset causes file locks and quota burn.
DATA_DIR=C:/dev/data/baf
ARTIFACT_DIR=./backend/ml/artifacts

# --- decision policy economics -------------------------------------------
# The approve / review / block thresholds are NOT set here. They are DERIVED
# from these business inputs by minimising expected cost, then capped by
# analyst capacity. A risk owner changes the bank's appetite by editing these
# numbers - no retraining, no code change, no hand-tuned cut-off.
#
# COST_FP_INR      wrongly blocking a genuine applicant (lost customer,
#                  servicing cost, reputational drag). This is the "false
#                  positive" the brief asks us to reduce - priced, not asserted.
# COST_FN_INR      approving a fraudulent application (expected write-off)
# COST_REVIEW_INR  one manual analyst review. Must be below COST_FP_INR,
#                  or reviewing is never cheaper than blocking.
# ANALYST_CATCH_RATE  probability an analyst correctly identifies fraud once
#                  a case reaches them.
COST_FP_INR=1500
COST_FN_INR=45000
COST_REVIEW_INR=200
ANALYST_CATCH_RATE=0.90

# Share of application volume the fraud operations team can actually review.
# Optimal thresholds assume unlimited analyst time; this is what makes the
# resulting policy staffable rather than a backlog.
MAX_REVIEW_RATE=0.05
